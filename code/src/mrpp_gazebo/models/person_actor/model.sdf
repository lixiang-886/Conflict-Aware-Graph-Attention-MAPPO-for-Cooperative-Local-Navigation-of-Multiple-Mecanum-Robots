<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PLACEHOLDER_NAME">
    <static>true</static>
  </model>
  <actor name="PLACEHOLDER_NAME">
    <pose>PLACEHOLDER_POSE</pose>
    <skin>
      <filename>model://person_actor/meshes/stand.dae</filename>
      <scale>1.0</scale>
    </skin>
    <animation name="walking">
      <filename>model://person_actor/meshes/walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>
    <script>
      <loop>true</loop>
      <delay_start>0.0</delay_start>
      <auto_start>true</auto_start>
      <trajectory id="0" type="walking">
        PLACEHOLDER_WAYPOINTS
      </trajectory>
    </script>
  </actor>
</sdf>
