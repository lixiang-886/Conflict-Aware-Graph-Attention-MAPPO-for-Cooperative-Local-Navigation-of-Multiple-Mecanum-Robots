<?xml version="1.0"?>
<sdf version="1.9">
  <model name="PLACEHOLDER_NAME">
    <pose>PLACEHOLDER_POSE</pose>
    <static>false</static>

    <!-- 躯干 - 细长圆柱 -->
    <link name="body">
      <pose>0 0 0.35 0 0 0</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.12</radius><length>0.5</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.12</radius><length>0.5</length></cylinder></geometry>
        <material><diffuse>PLACEHOLDER_COLOR</diffuse></material>
      </visual>
      <!-- 头部 -->
      <visual name="head_visual">
        <pose>0 0 0.32 0 0 0</pose>
        <geometry><sphere><radius>0.1</radius></sphere></geometry>
        <material><diffuse>0.95 0.8 0.6 1</diffuse></material>
      </visual>
      <inertial>
        <mass>30.0</mass>
        <inertia>
          <ixx>1.0</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.0</iyy><iyz>0</iyz>
          <izz>0.3</izz>
        </inertia>
      </inertial>
    </link>

    <!-- 左轮 -->
    <link name="left_wheel">
      <pose>0 0.13 0.04 1.5708 0 0</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.04</radius><length>0.015</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.04</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0002</iyy><iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
    </link>

    <!-- 右轮 -->
    <link name="right_wheel">
      <pose>0 -0.13 0.04 1.5708 0 0</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.04</radius><length>0.015</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.04</radius><length>0.015</length></cylinder></geometry>
        <material><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0002</iyy><iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>body</parent>
      <child>left_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>body</parent>
      <child>right_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.25</wheel_separation>
      <wheel_radius>0.04</wheel_radius>
      <topic>PLACEHOLDER_NS/cmd_vel</topic>
      <odom_topic>PLACEHOLDER_NS/odom</odom_topic>
    </plugin>
  </model>
</sdf>
