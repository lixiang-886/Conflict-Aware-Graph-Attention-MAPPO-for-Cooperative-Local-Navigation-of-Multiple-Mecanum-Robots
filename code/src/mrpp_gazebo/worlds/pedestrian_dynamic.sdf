<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pedestrian_dynamic">
    <gravity>0 0 -9.8</gravity>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <visualize>false</visualize>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 走廊墙壁 - 上 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 2</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 走廊墙壁 - 下 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 2</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 走廊墙壁 - 左 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 2</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 走廊墙壁 - 右 -->
    <model name="wall_east">
      <static>true</static>
      <pose>6 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10 2</size></box></geometry><material><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
